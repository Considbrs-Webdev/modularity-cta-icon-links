{
    "name": "considbrs-webdev/modularity-cta-icon-links",
    "description": "Modularity module: CTA icon links in a responsive column grid (Municipio/Modularity).",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "plugin",
        "modularity",
        "municipio",
        "acf"
    ],
    "homepage": "https://github.com/helsingborg-stad/modularity-cta-icon-links",
    "support": {
        "issues": "https://github.com/helsingborg-stad/modularity-cta-icon-links/issues",
        "source": "https://github.com/helsingborg-stad/modularity-cta-icon-links"
    },
    "authors": [
        {
            "name": "Considbrs-Webdev",
            "email": "webdev@considbrs.se"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "composer/installers": "^1.0 || ^2.0"
    },
    "suggest": {
        "helsingborg-stad/municipio": "^6.0.0",
        "helsingborg-stad/wpservice": "^2.0",
        "helsingborg-stad/wputilservice": "^0.2.44"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "carthage-software/mago": "^1.0.0-rc.3"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-html .coverage/html --coverage-clover .coverage/clover.xml",
        "lint": "vendor/bin/mago lint",
        "fix": "vendor/bin/mago lint --format-after-fix --fix",
        "format": "vendor/bin/mago fmt"
    },
    "autoload": {
        "psr-4": {
            "ModularityCtaIconLinks\\": "source/php/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "carthage-software/mago": true
        }
    }
}
